# Copy this file to .env for local development. Git ignores .env.
# Variables set in the shell take priority over this file.

# Required. Replace it with your own random value, for example the output of:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# Only the value True, in any letter case, turns debug mode on.
DEBUG=True

# Comma-separated host names.
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use db.sqlite3 in the project root. Otherwise use a URL such as
# sqlite:////absolute/path/to/file.sqlite3
DATABASE_URL=
